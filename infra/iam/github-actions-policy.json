{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SiteSync",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::knead-bake-site-771397891596",
        "arn:aws:s3:::knead-bake-site-771397891596/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::771397891596:distribution/EGVAZTETB6XRU"
    },
    {
      "Sid": "CDKRoleAssume",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::771397891596:role/cdk-hnb659fds-deploy-role-771397891596-us-east-1",
        "arn:aws:iam::771397891596:role/cdk-hnb659fds-file-publishing-role-771397891596-us-east-1",
        "arn:aws:iam::771397891596:role/cdk-hnb659fds-image-publishing-role-771397891596-us-east-1",
        "arn:aws:iam::771397891596:role/cdk-hnb659fds-lookup-role-771397891596-us-east-1"
      ]
    }
  ]
}
